<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/thumbnail_width_horizontal"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_s"
    android:orientation="vertical"
    android:background="@drawable/bg_premium_card_subtle"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/thumbnail_height"
        android:background="@drawable/bg_rounded_surface">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cd_thumbnail"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_thumbnail_scrim_bottom" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_pill_dark"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/white"
            android:textSize="11sp"
            tools:text="12:35" />

        <ImageButton
            android:id="@+id/btnVideoMore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:layout_margin="5dp"
            android:background="@drawable/bg_circle_scrim"
            android:padding="9dp"
            android:src="@drawable/ic_more"
            android:tint="@android:color/white"
            android:contentDescription="@string/action_video_options" />

        <ProgressBar
            android:id="@+id/progressWatched"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_track"
            android:visibility="visible"
            tools:progress="40" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        style="@style/VideoTitleText"
        android:layout_marginTop="7dp"
        android:minHeight="38dp"
        tools:text="Movie Name" />

</LinearLayout>
