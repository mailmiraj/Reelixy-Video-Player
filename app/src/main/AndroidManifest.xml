<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Media access permissions, version-aware -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:name=".VideoPlayerApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VideoPlayer"
        android:hardwareAccelerated="true"
        tools:targetApi="33">

        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VideoPlayer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.VideoPlayer.Player" />

        <activity
            android:name=".activities.LibraryActivity"
            android:exported="false"
            android:label="Library"
            android:theme="@style/Theme.VideoPlayer" />

        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/Theme.VideoPlayer" />

        <activity
            android:name=".activities.SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.VideoPlayer" />

        <activity
            android:name=".activities.PlaylistDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.VideoPlayer" />

    </application>

</manifest>
