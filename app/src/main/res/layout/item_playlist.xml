<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_premium_card_subtle"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/touch_target_min"
    android:paddingStart="@dimen/spacing_m"
    android:paddingEnd="@dimen/spacing_m"
    android:paddingTop="@dimen/spacing_s"
    android:paddingBottom="@dimen/spacing_s">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_playlist"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tvPlaylistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_s"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="15sp"
        tools:text="Anime" />

    <TextView
        android:id="@+id/btnPlaylistMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="⋮"
        android:textSize="20sp"
        android:textColor="?android:attr/textColorSecondary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/cd_more" />

    <TextView
        android:id="@+id/tvPlaylistCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:background="@drawable/bg_pill_dark"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="@android:color/white"
        tools:text="12 videos" />

</LinearLayout>
